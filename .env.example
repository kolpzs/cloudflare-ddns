# ==============================================================================
# Cloudflare DDNS — environment configuration
# Copy this file to `.env` and fill in the values.
# ==============================================================================

# Cloudflare API token. Must have the "Zone > DNS > Edit" permission.
# Create one at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# Comma-separated list of DNS-only "A" records to keep in sync (FQDN).
# The zone is resolved automatically from the domain, so no Zone ID or
# Account ID is required.
# Example: CF_RECORDS=home.example.com,vpn.example.com
CF_RECORDS=

# Time-to-live in seconds for the DNS records (Cloudflare minimum is 120).
CF_TTL=120

# How often to check for public IP changes, in seconds.
# Default 300 = 5 minutes.
CHECK_INTERVAL=300

# Optional: override the ordered list of public IP echo providers
# (comma-separated URLs). Leave empty to use the built-in defaults.
CF_IP_PROVIDERS=
